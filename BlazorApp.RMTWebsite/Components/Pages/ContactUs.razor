@page "/contact"
@using Models

<PageTitle>Contact Us</PageTitle>

<h3 style="text-align:center">Contact Us</h3>
<hr />
<br />

<div class="container w-75">
    <!--NEED TO UPDATE TO A FORM TO COLLECT USER INFO-->
    <EditForm Model="inquiry" OnValidSubmit="Submit" FormName="inquiryForm">
        <DataAnnotationsValidator />

        <label for="firstName">First Name</label>
        <div class="mt-1 w-25 form-floating">
            
            <InputText id="firstName" class="form-control" @bind-Value="inquiry.FirstName" placeholder="John"/>
            <ValidationMessage For="@(() => inquiry.FirstName)" />
        </div>

        <label for="lastName">Last Name</label>
        <div class="mt-1 w-25 form-floating">
            <InputText id="lastName" class="form-control" @bind-Value="inquiry.LastName" placeholder="Smith" />
            <ValidationMessage For="@(() => inquiry.LastName)" />
        </div>

        <label for="emailAddress">Email Address</label>
        <div class="mt-1 w-25 form-floating">
            <InputText id="emailAddress" class="form-control" @bind-Value="inquiry.EmailAddress" placeholder="Example@email.com" />
            <ValidationMessage For="@(() => inquiry.EmailAddress)" />
        </div>

        <label for="emailSubject">Subject Title</label>
        <div class="mt-1 w-25 form-floating">
            <InputText id="emailSubject" class="form-control" @bind-Value="inquiry.EmailSubject" placeholder="Available Appointments" />
            <ValidationMessage For="@(() => inquiry.EmailSubject)" />
        </div>

        <label for="emailContent">Message:</label>
        <div class="mt-1 w-75">
            <InputTextArea id="emailContent" class="form-control" @bind-Value="inquiry.EmailContent" rows="5" placeholder="Enter Message Here"/>
            <ValidationMessage For="@(() => inquiry.EmailContent)" />
        </div>

        <button type="submit" class="btn btn-primary mt-1" style="border-radius:10px">Submit</button>
    </EditForm>

</div>

@code {

    //email object to contain sender information
    EmailInquiry inquiry = new();

    private void Submit()
    {

    }
}