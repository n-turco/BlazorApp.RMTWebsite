@page "/contact"
@using Models
@inject IEmailSender emailSender
@inject ILogger<ContactUs> Logger
@* @rendermode InteractiveServer *@



<PageTitle>Contact Us</PageTitle>

@* Shared heading (plan 2.8). The form layout below is reworked in 3.1. *@
<PageHeader Title="Contact us" Subtitle="Questions or appointment requests? Send a message below." />

@* A plain .container (no w-75) so the form's left edge lines up with the heading (plan 2.8). *@
<div class="container">
    <!--NEED TO UPDATE TO A FORM TO COLLECT USER INFO-->
    <EditForm Model="Inquiry" OnValidSubmit="ValidSubmit" FormName="inquiryForm" Enhance>
        <DataAnnotationsValidator />

        <label for="emailAddress"><h5>Email Address</h5></label>
        <div class="mt-1 w-25">
            <InputText id="emailAddress" class="form-control" @bind-Value="Inquiry!.EmailAddress" placeholder="Example@email.com" />
            <ValidationMessage For="@(() => Inquiry!.EmailAddress)" />
        </div>

        <label for="emailSubject"><h5>Subject Title</h5></label>
        <div class="mt-1 w-25">
            <InputText id="emailSubject" class="form-control" @bind-Value="Inquiry!.EmailSubject" placeholder="Available Appointments" />
            <ValidationMessage For="@(() => Inquiry!.EmailSubject)" />
        </div>

        <label for="emailContent"><h5>Message:</h5></label>
        <div class="message-field mt-1 w-75">
            <InputTextArea id="emailContent" class="form-control" @bind-Value="Inquiry!.EmailContent" rows="5" placeholder="Enter Message Here" />
            <ValidationMessage For="@(() => Inquiry!.EmailContent)" />
        </div>

        <button type="submit" class="btn btn-primary rounded-3 mt-1" data-disable-on-submit>Submit</button>
    </EditForm>
    <label>@infoLabel</label>
</div>


@code {
    [SupplyParameterFromForm]
    private EmailInquiry? Inquiry { get; set; }
    // The OnInitialized method is overridden to ensure that the Inquiry property is initialized to a new instance of EmailInquiry if it is null.
    protected override void OnInitialized()
    {
        Inquiry ??= new();
    }
    private string infoLabel = string.Empty;
    // The ValidSubmit method is an asynchronous method that is called when the form is submitted and validated successfully.
    private async Task ValidSubmit()
    {
        if (Inquiry != null)
        {
            try
            {
                await emailSender.SendEmailAsync(Inquiry.EmailAddress, Inquiry.EmailSubject, Inquiry.EmailContent);
                infoLabel = "Message successfully sent.";
                //clear the form
                Inquiry = new EmailInquiry();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to send contact form email.");
                infoLabel = "Something went wrong. Message failed to send.";
            }
        }
    }
}
