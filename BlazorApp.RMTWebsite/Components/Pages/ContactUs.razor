@page "/contact"
<PageTitle>Contact Us</PageTitle>

<h3 style="text-align:center">Contact Us</h3>
<hr/>
<br/>

<!--NEED TO UPDATE TO A FORM TO COLLECT USER INFO-->
<div class="container">
<form>
        <div class="row g-2 w-50">
        <div class="col-sm pt-1">
            <input type="text" class="form-control" placeholder="First Name" aria-label="First Name"/>
        </div>
        <div class="col-sm pt-1">
            <input type="text" class="form-control" placeholder="Last Name" aria-label="Last Name" />
        </div>
    </div>
        <div class="row g-1 pt-1 w-50">
        <div>
            <input type="text" class="form-control" placeholder="Email Address" aria-label="Email Address" />
        </div>
    </div>
    <div class="row g-1 pt-1 w-75">
            <div>
                <textarea class="form-control" rows="5" style="resize:none;" placeholder="Enter message here" aria-label="Message">
                </textarea>    
        </div>
    </div>
</form>
</div>
