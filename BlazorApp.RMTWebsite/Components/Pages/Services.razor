@page "/services"
@using BlazorApp.RMTWebsite.Services
@inject IServiceCatalog Catalog
<PageTitle>Services</PageTitle>
<h1>Services</h1>

<hr/>
<br/>
<!--NEED TO ADD A BUTTON TO EACH OPTION FOR BOOKING-->
<div class="container">
<table class="table">
    <thead>
        <tr>
            <th>Treatment Type</th>
            <th>Treatment Length</th>
            <th>Treatment Cost</th>
        </tr>
    </thead>
    <tbody>
        @* Rows come from IServiceCatalog (plan 2.2), the same source as the Home page's "from" price. *@
        @foreach (var offering in Catalog.GetAll())
        {
            foreach (var option in offering.Options)
            {
                <tr>
                    <td>@offering.Name</td>
                    <td>@option.Minutes minute Massage</td>
                    <td>@option.FormattedPrice</td>
                </tr>
            }
        }
    </tbody>
</table>
</div>