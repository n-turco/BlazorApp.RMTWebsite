@inherits LayoutComponentBase
@inject NavigationManager Navigation

@* Page skeleton (plan 2.3): skip link → sticky top navbar → page content → footer.
   d-flex/min-vh-100 with flex-grow-1 on <main> keeps the footer at the bottom of short pages. *@
<div class="d-flex flex-column min-vh-100">
    @* First focusable element, so keyboard users can jump past the nav (WCAG 2.4.1). Hidden until
       focused. The href includes the current path because <base href="/"> would otherwise resolve
       "#main-content" to the home page. data-enhance-nav="false" lets the browser do a plain in-page
       jump, which also moves keyboard focus into <main>. *@
    <a class="visually-hidden-focusable skip-link" href="@SkipLinkHref" data-enhance-nav="false">Skip to main content</a>

    <header class="sticky-top">
        <NavMenu />
    </header>

    @* tabindex="-1" lets the skip link move focus here without adding <main> to the Tab order. *@
    <main id="main-content" class="content px-3 px-lg-4 flex-grow-1" tabindex="-1">
        @Body
    </main>

    <SiteFooter />
</div>

@code {
    /// <summary>Current page path (with any query string, without a fragment) plus "#main-content".</summary>
    private string SkipLinkHref =>
        $"{Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0]}#main-content";
}
