@* Top navbar (plan 2.3): logo left, links and Book now right. Below Bootstrap's lg breakpoint
   (992px) the links fold into a menu opened by the toggler button. Bootstrap's collapse script
   (loaded in App.razor) handles the click and keeps aria-expanded up to date. *@
<nav class="navbar navbar-expand-lg site-navbar" aria-label="Main">
    <div class="container-fluid px-3 px-lg-4">
        <BrandLogo />

        @* A real <button>, so screen readers announce "Menu, button, collapsed/expanded".
           aria-controls points at the list it opens. *@
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav"
                aria-controls="main-nav" aria-expanded="false" aria-label="Menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        @* Enhanced navigation re-renders this <div> from the server's HTML (class "collapse", no
           "show"), so the open phone menu closes after a link is followed. *@
        <div class="collapse navbar-collapse" id="main-nav">
            <ul class="navbar-nav ms-auto align-items-lg-center">
                @* NavLink adds class="active" and aria-current="page" to the current page's link. *@
                <li class="nav-item"><NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="services">Services</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="about">About Me</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="contact">Contact Us</NavLink></li>
                <li class="nav-item"><NavLink class="nav-link" href="faq">FAQ</NavLink></li>
                @* Points at the contact form until online booking exists (plan 4.1 changes this one URL). *@
                <li class="nav-item book-item">
                    <a class="btn btn-accent book-button" href="contact">Book now</a>
                </li>
            </ul>
        </div>
    </div>
</nav>
