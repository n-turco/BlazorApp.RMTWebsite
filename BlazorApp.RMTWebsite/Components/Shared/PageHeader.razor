@* Shared page heading (plan 2.8; used on every content page except Home, whose hero is its header):
   the page's single <h1>, an optional subtitle, and a divider below, so every page starts the same
   way without <hr>/<br> spacing hacks. Usage, as the first thing on a page:
       <PageHeader Title="Services and rates" Subtitle="Registered massage therapy in Guelph, Ontario" />
   It brings its own .container, so its left edge lines up with page content in a .container at every
   width without each page having to remember a wrapper. Place it outside the page's own container
   (a container inside a container doubles the side padding).
   It does not set <PageTitle>; each page still sets its own browser-tab title. *@
<div class="container">
    <header class="page-header">
        <h1 class="page-header-title">@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="page-header-subtitle">@Subtitle</p>
        }
    </header>
</div>

@code {
    /// <summary>The page heading, rendered as the page's only &lt;h1&gt;. Required.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Optional one-line summary shown under the heading.</summary>
    [Parameter]
    public string? Subtitle { get; set; }
}
