<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    @* Start downloading the body font before the CSS is parsed (ADR 0003). crossorigin is
       required on font preloads, even same-origin, or the browser downloads the file twice. *@
    <link rel="preload" href="fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap-icons/font/bootstrap-icons.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BlazorApp.RMTWebsite.styles.css"]" />
    <ImportMap />
    @* KF monogram favicon set (plan 2.1). favicon.ico stays at a plain root URL because some clients
       request /favicon.ico directly; the others use @Assets so a changed icon gets a new URL and
       browsers don't keep showing a cached old one. *@
    <link rel="icon" href="favicon.ico" sizes="32x32" />
    <link rel="icon" href="@Assets["favicon.svg"]" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="@Assets["apple-touch-icon.png"]" />
    @* Colours the phone browser's address bar to match the black header. *@
    <meta name="theme-color" content="#000000" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/form-submit.js"]"></script>
</body>

</html>
