<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BlazorApp.RMTWebsite.Tests</RootNamespace>
    <!-- xUnit v3 test projects build as executables -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy the site's stylesheet, icons, fonts and .razor markup into the test output (under SiteFiles/)
         so the source-file tests (FontAssetTests, IconAssetTests, HeadingStructureTests, ...) can read
         them without fragile ../../.. paths. Link sets the output path. -->
    <Content Include="..\BlazorApp.RMTWebsite\wwwroot\app.css" Link="SiteFiles\wwwroot\app.css" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\BlazorApp.RMTWebsite\wwwroot\favicon.*;..\BlazorApp.RMTWebsite\wwwroot\apple-touch-icon.png" Link="SiteFiles\wwwroot\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\BlazorApp.RMTWebsite\wwwroot\fonts\**" Link="SiteFiles\wwwroot\fonts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\BlazorApp.RMTWebsite\Components\**\*.razor" Link="SiteFiles\Components\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets every test file use [Fact], [Theory] and Assert without a using line -->
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorApp.RMTWebsite\BlazorApp.RMTWebsite.csproj" />
  </ItemGroup>

</Project>
